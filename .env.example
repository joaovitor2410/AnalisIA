# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o Git.

# Modelo usado pelo agente, no formato "provedor:modelo" do Pydantic AI.
# O provedor implementado nesta versão é o Google (Gemini).
OLHEIRO_MODEL=google:gemini-3.8-flash

# Modelo reserva, usado se o principal falhar na API (cota esgotada, 503, prazo). Opcional.
# No nível gratuito cada modelo tem a própria cota diária: prefira um de outra linha (lite).
OLHEIRO_FALLBACK_MODEL=google:gemini-3.5-flash-lite

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Caminhos (opcionais; os padrões abaixo já funcionam)
# DUCKDB_PATH=data/olheiro.duckdb
# RAW_DATA_DIR=data/raw
# EXPORTS_DIR=data/exports
# WORKSPACE_PATH=data/workspace.duckdb   (único banco onde o agente grava)
# GLOSSARY_PATH=semantic/glossary.toml
# ANSWER_CACHE_PATH=data/answer_cache.json
# DASHBOARD_PATH=data/dashboard.json

# Limite por sessão (vazio = sem limite; 0 = só cache; Compose usa 5 por padrão).
# OLHEIRO_SESSION_QUESTION_LIMIT=5
# Porta do host no Docker Compose. Não altera o Streamlit rodando diretamente.
# OLHEIRO_PORT=8501

# Observabilidade: traces OpenTelemetry em arquivo local (padrão), num backend OTLP, ou desligados.
# OLHEIRO_TRACING=file          # off | file | otlp
# OLHEIRO_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OLHEIRO_TRACE_CONTENT=true    # false numa demo pública (não grava perguntas/respostas nos traces)
# TRACES_PATH=data/traces.jsonl
# RUNS_PATH=data/runs.jsonl
