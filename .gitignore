# Segredos
.env

# Ambiente e caches do Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/

# Banco gerado a partir dos CSVs (pode ser recriado com `uv run olheiro-load`)
data/*.duckdb
data/*.duckdb.wal

# Estado local do app (cache de respostas e dashboard)
data/answer_cache.json
data/dashboard.json
data/runs.jsonl
data/traces.jsonl
# Bases particulares importadas (inclui cópias dos CSVs/Parquets e estado por base)
data/datasets/

# Exportações geradas pelo agente
data/exports/*
!data/exports/.gitkeep

# Sistema
.DS_Store
